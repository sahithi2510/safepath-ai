# ============================================================
# SafePath AI — Production Environment Variables (.env)
# ============================================================
# Copy this file to .env on your cloud server:
#   cp .env.production.example .env
# Replace the placeholder values with secure generated keys.
# ============================================================

# Domain / HTTPS Configuration
# If you have a custom domain (e.g. api.safepath.com), set it here.
# If you only have a VPS Public IP, put your VPS IP here.
DOMAIN_NAME=your-server-domain-or-ip.com
SSL_EMAIL=your-email@example.com

# PostgreSQL Database Configuration
POSTGRES_DB=safepath_db
POSTGRES_USER=safepath_prod_user
# Generate a strong password: openssl rand -base64 24
POSTGRES_PASSWORD=generate_a_strong_password_here_min_16_chars

# Spring Boot JWT Security Configuration
# Generate a 256-bit secret: openssl rand -hex 64
JWT_SECRET=generate_a_64_character_hex_string_for_secure_jwt_tokens
JWT_EXPIRATION_MS=86400000

# Service Interconnection
ML_SERVICE_TIMEOUT_MS=5000
ML_LOG_LEVEL=info

# Cross-Origin Resource Sharing (CORS)
# Allow requests from your mobile app / web client
CORS_ALLOWED_ORIGINS=*

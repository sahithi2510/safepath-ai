# ============================================================
# SafePath AI — Mobile Environment Configuration (.env)
# ============================================================
# Configure the backend server API endpoint.
#
# Options:
# 1. 24/7 Cloud Production Server (Render / Cloud VPS):
#    EXPO_PUBLIC_API_URL=https://your-cloud-domain.com/api
#
# 2. Localhost Development (Android Emulator):
#    EXPO_PUBLIC_API_URL=http://10.0.2.2:8080/api
#
# 3. Localhost Development (iOS Simulator / Web):
#    EXPO_PUBLIC_API_URL=http://localhost:8080/api
#
# 4. Physical Android Phone (Same Wi-Fi network):
#    EXPO_PUBLIC_API_URL=http://192.168.x.x:8080/api
# ============================================================

EXPO_PUBLIC_API_URL=http://localhost:8080/api
EXPO_PUBLIC_DEMO_MODE=false
EXPO_PUBLIC_MAPBOX_TOKEN=


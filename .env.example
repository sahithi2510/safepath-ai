# ============================================================
# SafePath AI — Environment Variables Example
# Copy this file to .env and fill in real values.
# NEVER commit .env to Git.
# ============================================================

# -------------------------------------------------------
# PostgreSQL / PostGIS
# -------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=safepath_db
POSTGRES_USER=safepath_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# -------------------------------------------------------
# Spring Boot Backend
# -------------------------------------------------------
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/safepath_db
SPRING_DATASOURCE_USERNAME=safepath_user
SPRING_DATASOURCE_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# JWT — use a long random string (min 256 bits)
JWT_SECRET=CHANGE_ME_VERY_LONG_RANDOM_SECRET_AT_LEAST_256_BITS
JWT_EXPIRATION_MS=86400000

# ML Service base URL
ML_SERVICE_URL=http://localhost:8001
ML_SERVICE_TIMEOUT_MS=5000

# Backend server port
SERVER_PORT=8080

# CORS — comma-separated allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:8081,exp://localhost:8081

# -------------------------------------------------------
# FastAPI ML Service
# -------------------------------------------------------
ML_HOST=0.0.0.0
ML_PORT=8001
ML_MODEL_DIR=./models
ACTIVE_MODEL=xgboost
MAX_BATCH_SIZE=500
ML_LOG_LEVEL=info

# -------------------------------------------------------
# External APIs (all optional — free/open)
# -------------------------------------------------------

# Open-Meteo — free, no key required
# OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# Nominatim — free OSM geocoding (respect usage policy)
# NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# NOMINATIM_USER_AGENT=SafePathAI/1.0 (your-email@example.com)

# Overpass API — free OSM data
# OVERPASS_BASE_URL=https://overpass-api.de/api

# -------------------------------------------------------
# Mobile (Expo)
# -------------------------------------------------------
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080/api
EXPO_PUBLIC_DEMO_MODE=false

# -------------------------------------------------------
# Docker Compose (override per environment)
# -------------------------------------------------------
COMPOSE_PROJECT_NAME=safepath-ai

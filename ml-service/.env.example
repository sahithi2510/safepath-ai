# ============================================================
# SafePath AI — FastAPI ML Service Environment Configuration
# ============================================================
# Copy this file to .env inside ml-service/ or use root .env.
# NEVER commit real production secrets.
# ============================================================

# Host and port for inference server
ML_HOST=0.0.0.0
ML_PORT=8001

# Path to trained model artifacts directory
ML_MODEL_DIR=./models

# Preferred inference model architecture ("xgboost" or "random_forest")
ACTIVE_MODEL=xgboost

# Maximum allowed segments in a single batch prediction request
MAX_BATCH_SIZE=500

# Logging level (debug, info, warning, error)
ML_LOG_LEVEL=info
